{
  "name": "@veil/contracts-production",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network mainnet",
    "preflight:sepolia": "hardhat run scripts/preflight.ts --network sepolia",
    "preflight:mainnet": "hardhat run scripts/preflight.ts --network mainnet",
    "smoke:sepolia": "hardhat run scripts/smoke.ts --network sepolia",
    "smoke:mainnet": "hardhat run scripts/smoke.ts --network mainnet",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fhevm/solidity": "0.13.3",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "5.4.0",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@types/node": "^24.0.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "typescript": "^5.9.3"
  }
}
