# Never commit real secrets.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/replace-me
MAINNET_RPC_URL=https://mainnet.infura.io/v3/replace-me
DEPLOYER_PRIVATE_KEY=0xreplace-me

# Governance owner. Mainnet preflight requires deployed contract bytecode here
# (for example a Safe multisig), never the deployer EOA.
OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# Existing Sepolia ERC-7984 asset accepted by the pool.
CONFIDENTIAL_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Mainnet deployment has a hard broadcast interlock. Do not set this during preflight.
# CONFIRM_MAINNET_DEPLOY=DEPLOY_VEIL_TO_ETHEREUM

# Six-decimal cUSDT units. Example: 25 cUSDT = 25000000.
PRIZE_PER_DRAW=25000000
DRAW_PERIOD_SECONDS=600

# Required by the post-deployment smoke script.
POOL_ADDRESS=0x0000000000000000000000000000000000000000
